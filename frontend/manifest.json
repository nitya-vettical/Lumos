
{
  "manifest_version": 3,
  "name": "Colorblind Helper",
  "version": "1.0",
  "description": "A Chrome extension to assist colorblind users with color adjustments.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons":{
    "16":"icon16.png",
    "48":"icon48.png",
    "64":"icon128.png"
  },
  "action": {
      "default_popup": "popup.html",
      "default_icon": "icon48.png"
  }
  
}



